# Tuya IoT Platform Cloud project credentials
# Find these under Cloud > Overview in the Tuya IoT Platform.
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=

# API base URL for your project's data center, e.g.:
#   https://openapi.tuyaus.com   (Western America)
#   https://openapi.tuyaeu.com   (Central Europe)
#   https://openapi.tuyacn.com   (China)
#   https://openapi.tuyain.com   (India)
TUYA_BASE_URL=

# uid of the Smart Life / Tuya Smart app account linked to this Cloud project
# (Cloud > Devices > Link Tuya App Account). Needed to list devices for discovery.
TUYA_UID=

# Backend server port
PORT=3001

# SQLite database file path
DB_PATH=../../data/readings.sqlite

# How often the poller checks devices, in milliseconds
POLL_INTERVAL_MS=60000
