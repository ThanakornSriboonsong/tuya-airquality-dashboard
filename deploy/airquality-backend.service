[Unit]
Description=Air quality rig backend (poller + REST API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=airquality
# Load-bearing: ConfigModule reads "../../.env" relative to the working
# directory, and DB_PATH is resolved from here too.
WorkingDirectory=/srv/airquality/apps/backend
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
